class Solution {
public:
bool traversal(TreeNode* root1,TreeNode* root2)
{
    if(root1==NULL && root2==NULL)
    {
        return true;
    }
    if(root1==NULL || root2==NULL)
    {
        return false;
    }
    if(root1->val==root2->val && traversal(root1->left,root2->right)&&traversal(root1->right,root2->left))
    {
        return true;
    }
    
    return false;
}
    bool isSymmetric(TreeNode* root) {
        return traversal(root,root);
        
    }
};
